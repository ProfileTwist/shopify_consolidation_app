APP_NAME="SF Consolidator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sfc
DB_USERNAME=sfc
DB_PASSWORD=secret

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Salesforce sync — "mock" generates sample orders; switch to "http" for a real org.
SALESFORCE_DRIVER=mock
SALESFORCE_API_VERSION=v62.0
SALESFORCE_MOCK_ORDERS=25
