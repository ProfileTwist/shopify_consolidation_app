APP_NAME="Inbound Webhook API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Not used for request handling (webhooks are stateless), but Laravel expects a
# database connection to exist; sqlite keeps the image self-contained.
DB_CONNECTION=sqlite

# --- AWS / SNS ---
# For LocalStack these are set in docker-compose. In real AWS: set the topic ARN,
# region, and either static keys or (preferred) an IAM role on the task/instance.
AWS_ENDPOINT_URL=http://localstack:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:inbound-webhooks

# --- Shopify webhook verification ---
# In production set the app client secret and keep SKIP_VERIFY unset/false.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SKIP_VERIFY=true
