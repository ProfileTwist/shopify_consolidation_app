api/storage/framework/sessions/*
api/storage/framework/views/*
api/storage/framework/testing/*
api/storage/logs/*
api/bootstrap/cache/*.php
inbound-webhook-api/storage/*.key
inbound-webhook-api/storage/framework/cache/*
inbound-webhook-api/storage/framework/sessions/*
inbound-webhook-api/storage/framework/views/*
inbound-webhook-api/storage/logs/*
