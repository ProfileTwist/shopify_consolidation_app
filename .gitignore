# === Secrets / environment (NEVER commit real credentials) ===
# `.env` (no slash) matches .env at any depth: root, api/, web/, inbound-webhook-api/
.env
.env.local
.env.*.local
.env.backup
*.pem
auth.json
# NOTE: .env.docker / .env.example are templates (placeholders only) and ARE committed.

# === OS ===
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

